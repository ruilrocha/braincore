@startuml brain-io — Layered Architecture

title brain-io · Onion / Hexagonal Architecture

skinparam backgroundColor #1e1e2e
skinparam defaultFontName "JetBrains Mono"
skinparam defaultFontSize 12

skinparam package {
    BackgroundColor #2a2a3e
    BorderColor     #6e6e9e
    FontColor       #cdd6f4
    FontStyle       bold
}

skinparam rectangle {
    BackgroundColor #313244
    BorderColor     #89b4fa
    FontColor       #cdd6f4
    RoundCorner     8
}

skinparam arrow {
    Color           #89dceb
    FontColor       #a6e3a1
    FontSize        10
}

skinparam note {
    BackgroundColor #45475a
    BorderColor     #6c7086
    FontColor       #cdd6f4
    FontSize        10
}

' ── Composition root ──────────────────────────────────────────────────
rectangle "**main.cpp**\n//Composition Root//\nwires adapters → ports\nmode: Batch | Stream | Infinite" as main #1e1e2e {
}

' ── Adapter layer ─────────────────────────────────────────────────────
package "src/adapter/  ──  ADAPTERS (outermost ring)" as adapters {

    package "analysis/" as pkg_analysis {
        rectangle "MfccAnalyser\n──────────────\nimplements IAnalyser\nFFTW → MelFilterBank\n→ DCT → MFCC\n+ FFT magnitude bins" as MfccAnalyser
    }

    package "gateway/" as pkg_gateway {
        rectangle "LibSndFileGateway\n──────────────\nimplements ISoundFileGateway\nReads/writes WAV via libsndfile" as LibSndFile
    }

    package "effects/" as pkg_effects {
        rectangle "FftwSpectralMorph\n──────────────\nimplements IBlockEffect\nFFTW magnitude interp\n+ phase blend + RMS match" as SpectralMorph
    }

    package "playback/" as pkg_playback {
        rectangle "MiniaudioOutput\n──────────────\nimplements IAudioOutput\nRing buffer + miniaudio\ncallback thread" as Miniaudio
    }

    package "search/" as pkg_search {
        rectangle "ClosestSearch\nReverseSearch\nSynapticSearch\nRandomSearch\nWeightedRandomSearch\nMarkovChainSearch\nMomentumSearch\n──────────────\nall implement ISearchStrategy\nSearchUtils.h  (shared)" as Searches
    }
}

' ── Use-case layer ────────────────────────────────────────────────────
package "src/usecase/  ──  USE-CASE LAYER" as usecases {
    rectangle "SoundProcessor\n──────────────\nBatch: full-file\nreconstruction\n+ overlap-add" as SoundProc
    rectangle "StreamProcessor\n──────────────\nReal-time: block-by-block\nstream() or streamInfinite()\nevolving search_fp walk" as StreamProc
    rectangle "EffectHelpers\n──────────────\ngranularScatter()\napplyStutter()\napplyEnvelope()\n(shared by both)" as EffectHelpers
}

' ── Domain core ───────────────────────────────────────────────────────
package "src/domain/  ──  DOMAIN CORE (innermost ring)" as domain {

    package "Entities / Aggregates" as entities {
        rectangle "Brain\n──────────────\naddSound()\nfindBestMatch()\nbuildSynapses()\njiggle()\ndepleteUsage()" as Brain
        rectangle "Sound\n──────────────\nmulti-channel\naudio container" as Sound
        rectangle "Block\n──────────────\nsamples\nchannel_samples\nfingerprint ×4\ndominant_freq\nusage / synapses" as Block
    }

    package "Value Objects" as values {
        rectangle "SearchParams\n(all UI knobs)" as SearchParams
        rectangle "BlockConfig\nblock_size\noverlap\nWindowShape" as BlockConfig
        rectangle "Fingerprints\nprimary / secondary\nnormalised variants\ndominant_freq" as Fingerprints
        rectangle "Random.h\nrng::randomDouble()\nrng::randomIndex()\nthread_local mt19937" as Random
        rectangle "WindowFunction\n7 shapes\nnormalise()" as WinFn
    }

    package "PORT INTERFACES" as ports {
        rectangle "IAnalyser" as IAnalyser #313255
        rectangle "ISearchStrategy" as ISearch #313255
        rectangle "ISoundFileGateway" as IGateway #313255
        rectangle "IAudioOutput" as IAudio #313255
        rectangle "IBlockEffect" as IEffect #313255
    }
}

' ── In-tree DSP ───────────────────────────────────────────────────────
package "src/aquila/  ──  IN-TREE DSP" as aquila {
    rectangle "MelFilterBank\nDct" as Aquila
}

' ── Dependency arrows ─────────────────────────────────────────────────
main         --> SoundProc    : creates (batch)
main         --> StreamProc   : creates (stream/infinite)
main         --> Brain        : creates + configures
main         --> MfccAnalyser : injects → IAnalyser
main         --> Searches     : injects → ISearchStrategy
main         --> LibSndFile   : injects → ISoundFileGateway
main         --> SpectralMorph: injects → IBlockEffect
main         --> Miniaudio    : injects → IAudioOutput

SoundProc    --> Brain        : process()
SoundProc    --> EffectHelpers: uses
SoundProc    --> IEffect      : spectral_morph->apply()

StreamProc   --> Brain        : findBestMatch()\ndepleteUsage()
StreamProc   --> EffectHelpers: uses
StreamProc   --> IAudio       : write()
StreamProc   --> IEffect      : spectral_morph->apply()

Brain        --> IAnalyser    : analyse() / compute()
Brain        --> ISearch      : search()
Brain        ..> Block        : owns []
Brain        ..> Sound        : reads

MfccAnalyser ..|> IAnalyser   : implements
MfccAnalyser --> Aquila       : uses
LibSndFile   ..|> IGateway    : implements
SpectralMorph ..|> IEffect    : implements
Miniaudio    ..|> IAudio      : implements
Searches     ..|> ISearch     : implements (×7)

note bottom of domain
  Zero external library dependencies.
  All external calls go outward through ports.
end note

note bottom of adapters
  Each adapter depends only on its
  external library + domain port interfaces.
end note

@enduml

